FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

ARG VITE_ENABLE_DEMO_AUTH=false
ENV VITE_ENABLE_DEMO_AUTH=${VITE_ENABLE_DEMO_AUTH}

ARG VITE_DEMO_ADMIN_PHONE=
ENV VITE_DEMO_ADMIN_PHONE=${VITE_DEMO_ADMIN_PHONE}

ARG VITE_DEMO_ADMIN_PASSWORD=
ENV VITE_DEMO_ADMIN_PASSWORD=${VITE_DEMO_ADMIN_PASSWORD}

ARG VITE_DEMO_STAFF_PHONE=
ENV VITE_DEMO_STAFF_PHONE=${VITE_DEMO_STAFF_PHONE}

ARG VITE_DEMO_STUDENT_IDS=
ENV VITE_DEMO_STUDENT_IDS=${VITE_DEMO_STUDENT_IDS}

ARG VITE_DEMO_STUDENT_PASSWORD=
ENV VITE_DEMO_STUDENT_PASSWORD=${VITE_DEMO_STUDENT_PASSWORD}

ARG VITE_DEMO_STAFF_PASSWORD=
ENV VITE_DEMO_STAFF_PASSWORD=${VITE_DEMO_STAFF_PASSWORD}

RUN npm run build

FROM nginx:1.27-alpine

RUN apk add --no-cache wget

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
    CMD wget -q -O - http://127.0.0.1/ > /dev/null || exit 1
