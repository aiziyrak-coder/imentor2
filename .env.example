# Dev:  docker compose -f docker-compose.dev.yml up --scale backend=2 --build
# Prod: docker compose -f docker-compose.prod.yml --env-file deploy/.env.production up --scale backend=2 -d --build

# python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=

POSTGRES_DB=imentor
POSTGRES_USER=imentor
POSTGRES_PASSWORD=

# Brauzer (dev): http://localhost:8080
# Prod port: deploy/.env.production ichida IMENTOR_HTTP_PORT (default 9050)

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,imentor.uz,www.imentor.uz,api.imentor.uz
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,https://imentor.uz,https://www.imentor.uz,https://fermi.uz,https://www.fermi.uz
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,https://imentor.uz,https://www.imentor.uz,https://fermi.uz,https://www.fermi.uz

VITE_API_BASE_URL=/api
OPENAI_API_KEY=

# OnlineTest — talaba auth (bitta login). Masalan: http://host.docker.internal:8001
ONLINE_TEST_API_BASE_URL=https://online-imtixon.uz
# OnlineTest — Kafedra/Yo'nalish/Guruh katalogi uchun (ONLINE_TEST_PUBLIC_API_KEYS bilan mos)
ONLINE_TEST_CONSUMER_API_KEY=

ADMIN_PHONE=998907863888
ADMIN_PASSWORD=
DEMO_ADMIN_PHONES=998907863888

# Login modalidagi "Demo admin bilan kirish" chipi — parol kamida 6 belgi bo'lmasa
# chip yashirin qoladi. Telefon DEMO_ADMIN_PHONES bilan bir xil bo'lishi kerak.
VITE_ENABLE_DEMO_AUTH=true
VITE_DEMO_ADMIN_PHONE=998907863888
VITE_DEMO_ADMIN_PASSWORD=

OPENAI_CHAT_MODEL=gpt-4.1-nano
OPENAI_FAST_MODEL=gpt-4.1-nano
OPENAI_REASONER_MODEL=gpt-4.1-nano
